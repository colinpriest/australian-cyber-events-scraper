# Versions the lock uses instead of the ones installed where it was generated,
# because the installed set was itself inconsistent (pip check failed there).
# scripts/setup/lock_dependencies.py applies these and lists them as unverified
# offline; CI installs the lock and runs `pip check`, which verifies them.
# Format: name==version  # reason

# httpcore 1.0.6 requires h11<0.15; httpcore2 (used by httpx2 / TypeSafe) requires h11>=0.16.
# httpcore 1.0.9 is the 1.x release that requires h11>=0.16, satisfying both.
httpcore==1.0.9  # h11 0.16 for both httpcore and httpcore2
# anyio 4.15.1 and pydantic 2.14 require typing_extensions>=4.16.0; 4.15.0 was installed.
typing-extensions==4.16.0  # minimum required by anyio / pydantic
# httpx2 2.16.0 requires idna>=3.18; 3.11 was installed.
idna==3.18  # minimum required by httpx2
