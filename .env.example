# Copy to .env and fill in. Never commit .env.

# Required: OpenAI, for extraction, adjudication and classification
OPENAI_API_KEY=

# Recommended: Perplexity, for discovery, enrichment, timelines and corroboration
PERPLEXITY_API_KEY=

# Recommended: TypeSafe Jev, for the calibrated judgements (without it the fast
# OpenAI model is used and the calibrated steps only report)
TYPESAFE_API_KEY=

# Optional model overrides. Defaults are pinned, dated snapshots; see README
# "Language models and replicability". Changing one invalidates calibrations.
# OPENAI_MODEL=gpt-5.5-2026-04-23
# OPENAI_FAST_MODEL=gpt-5.4-mini-2026-03-17
# TYPESAFE_MODEL=jev-1.14.0
# PERPLEXITY_MODEL=sonar-pro

# Optional: Google Custom Search data source
GOOGLE_CUSTOMSEARCH_API_KEY=
GOOGLE_CUSTOMSEARCH_CX_KEY=

# Optional, GDELT only - BigQuery charges can run to hundreds of dollars
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Database used when no --db-path is given. Create it with: python pipeline.py init
DATABASE_URL=sqlite:///instance/cyber_events.db

# Processing
MAX_THREADS=10
BATCH_SIZE=20
