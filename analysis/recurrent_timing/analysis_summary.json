  "executive_summary": {
    "questions": [
      {
        "key": "adequacy",
        "question": "Is the data adequate for a reliable recurrence model?",
        "answer": "Adequate for a simple model: 171 repeats, 19 per parameter of the models used here; but the full adjusted model is over-parameterised (26 parameters, 6.6 repeats each, 0 not identified), so it is not used for these conclusions; 62% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted.",
        "adequate": true,
        "caveats": [
          "the full adjusted model is over-parameterised (26 parameters, 6.6 repeats each, 0 not identified), so it is not used for these conclusions",
          "62% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted"
        ]
      },
      {
        "key": "splits",
        "question": "What are the best splits for recurrence time bands?",
        "answer": "No split is supported beyond what the search finds by chance: the best of 593 bandings (0-365, 366-1095, >1095 days) beats a constant rate by 2.7 BIC, but searching constant-rate data does as well (p = 0.052)."
      },
      {
        "key": "vigilance",
        "question": "Is the rate lower 1-90 days after an event (short-term vigilance)?",
        "answer": "No evidence of short-term vigilance: the adjusted rate 1-90 days after an event is not lower than at other times (one-sided p = 0.888; 26 repeats against 21.2 expected if the rate were no different)."
      },
      {
        "key": "delayed_peak",
        "question": "Is there a delayed peak in recurrence 91-180 days after an event?",
        "answer": "No evidence of a delayed peak: the adjusted rate 91-180 days after an event is not higher than at other times (one-sided p = 0.121; 24 repeats). The narrower 91-120 day window holds only 7 repeats, too few to test on its own."
      },
      {
        "key": "best_fit",
        "question": "What fits recurrence rates best?",
        "answer": "Best fit by AIC, holding size, prior event number and a calendar trend: bands 0-365, 366-1095, >1095. Its bands were chosen by the search, and the search-adjusted test does not support them, so treat the rate as constant."
      },
      {
        "key": "size",
        "question": "Does organisation size predict recurrence rates?",
        "answer": "Yes: the recurrence rate rises with organisation size. Rate relative to SMALL organisations: MEDIUM 1.3, LARGE 3.6, HUGE 7.4 (monotone model holding prior event number and a calendar trend, bootstrap p <= 0.002 (no simulated value as extreme in 500)). Size stands for visibility and exposure as much as size: this is prediction, not cause."
      }
    ],
