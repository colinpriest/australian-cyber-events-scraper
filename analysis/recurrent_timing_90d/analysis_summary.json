{
  "executive_summary": {
    "questions": [
      {
        "key": "adequacy",
        "question": "Is the data adequate for a reliable recurrence model?",
        "answer": "Adequate for a simple model: 140 repeats, 16 per parameter of the models used here; but the full adjusted model is over-parameterised (26 parameters, 5.4 repeats each, 11 not identified), so it is not used for these conclusions; 56% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted.",
        "adequate": true,
        "caveats": [
          "the full adjusted model is over-parameterised (26 parameters, 5.4 repeats each, 11 not identified), so it is not used for these conclusions",
          "56% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted"
        ]
      },
      {
        "key": "splits",
        "question": "What are the best splits for recurrence time bands?",
        "answer": "Best bands: 0-365, 366-1095, >1095 days, with rates 1.00, 0.47, 1.01 times the first band's (strong evidence: 6.2 BIC better than a constant rate, holding size, prior event number and a calendar trend; search-adjusted p = 0.008). The long-term growth in recorded incidents does not explain it: the per-organisation rate changes by +3% a year (yearly effects from 2020, p = 0.67), and the bands hold under no calendar adjustment, a linear trend, monthly reporting intensity and yearly effects alike (p from 0.0003 to 0.0006)."
      },
      {
        "key": "delayed_peak",
        "question": "Is there a delayed peak in recurrence 91-180 days after an event?",
        "answer": "No evidence of a delayed peak: the adjusted rate 91-180 days after an event is not higher than at other times (one-sided p = 0.114; 18 repeats). The narrower 91-120 day window holds only 5 repeats, too few to test on its own."
      },
      {
        "key": "best_fit",
        "question": "What fits recurrence rates best?",
        "answer": "Best fit by AIC, holding size, prior event number and a calendar trend: bands 0-365, 366-1095, >1095. The constant rate is 12.1 AIC behind. The bands were chosen by the search, so that margin is optimistic."
      },
      {
        "key": "size",
        "question": "Does organisation size predict recurrence rates?",
        "answer": "Yes: the recurrence rate rises with organisation size. Rate relative to SMALL organisations: MEDIUM 1.0, LARGE 6.0, HUGE 14.0 (monotone model holding prior event number and a calendar trend, bootstrap p <= 0.002 (no simulated value as extreme in 500)). Size stands for visibility and exposure as much as size: this is prediction, not cause."
      }
    ],
