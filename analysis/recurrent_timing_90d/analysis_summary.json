{
  "executive_summary": {
    "questions": [
      {
        "key": "adequacy",
        "question": "Is the data adequate for a reliable recurrence model?",
        "answer": "Adequate for a simple model: 157 repeats, 20 per parameter of the models used here; but the full adjusted model is over-parameterised (26 parameters, 6.0 repeats each, 1 not identified), so it is not used for these conclusions; 52% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted.",
        "adequate": true,
        "caveats": [
          "the full adjusted model is over-parameterised (26 parameters, 6.0 repeats each, 1 not identified), so it is not used for these conclusions",
          "52% of incident dates are unverified, so gaps can be resolved only to about a month: splits finer than 30 days are not attempted"
        ]
      },
      {
        "key": "splits",
        "question": "What are the best splits for recurrence time bands?",
        "answer": "Best bands: 0-270, >270 days, with rates 1.00, 0.52 times the first band's (strong evidence: 8.1 BIC better than a constant rate, holding size, prior event number and a calendar trend; search-adjusted p = 0.010). The long-term growth in recorded incidents does not explain it: the per-organisation rate changes by -0% a year (yearly effects from 2020, p = 0.48), and the bands hold under no calendar adjustment, a linear trend, monthly reporting intensity and yearly effects alike (p from 0.0001 to 0.0003)."
      },
      {
        "key": "vigilance",
        "question": "Is the rate lower 1-90 days after an event (short-term vigilance)?",
        "answer": "No evidence of short-term vigilance: the adjusted rate 1-90 days after an event is not lower than at other times (one-sided p = 0.978; 27 repeats against 19.0 expected if the rate were no different)."
      },
      {
        "key": "delayed_peak",
        "question": "Is there a delayed peak in recurrence 91-180 days after an event?",
        "answer": "Yes: the adjusted rate 91-180 days after an event is 1.59 times the rate at other times (95% CI 0.99-2.44; one-sided p = 0.027; 25 repeats). The narrower 91-120 day window holds only 8 repeats, too few to test on its own."
      },
      {
        "key": "best_fit",
        "question": "What fits recurrence rates best?",
        "answer": "Best fit by AIC, holding size, prior event number and a calendar trend: bands 0-270, >270. The constant rate is 12.5 AIC behind. The bands were chosen by the search, so that margin is optimistic."
      },
      {
        "key": "size",
        "question": "Does organisation size predict recurrence rates?",
        "answer": "Yes: the recurrence rate rises with organisation size. Rate relative to SMALL organisations: MEDIUM 1.4, LARGE 3.6, HUGE 8.8 (monotone model holding prior event number and a calendar trend, bootstrap p <= 0.002 (no simulated value as extreme in 500)). Size stands for visibility and exposure as much as size: this is prediction, not cause."
      }
    ],
